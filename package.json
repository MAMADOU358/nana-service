{
  "name": "nana-service-pro",
  "version": "1.0.0",
  "description": "Système de gestion professionnel NANA SERVICE",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  },
  "scripts": {
