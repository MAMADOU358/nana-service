    "react-scripts":      "5.0.1",
    "react-router-dom":   "^6.20.0",
    "firebase":           "^10.7.1",
    "framer-motion":      "^10.16.0",
    "jspdf":              "^2.5.1",
    "jspdf-autotable":    "^3.7.0",
    "xlsx":               "^0.18.5",
    "date-fns":           "^3.0.0",
    "uuid":               "^9.0.0",
    "express":            "^4.18.2",
    "compression":        "^1.7.4"
  },
  "devDependencies": {
    "@testing-library/react":         "^14.1.0",
    "@testing-library/jest-dom":      "^6.1.5",
    "@testing-library/user-event":    "^14.5.1"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
